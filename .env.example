# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/citizenlink?schema=public"

# API
PORT=4000
JWT_SECRET="your-super-secret-jwt-key-change-this"

# M-Pesa (for later)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
MPESA_ENV="sandbox"

# SMS (for later)
SMS_API_KEY=""
SMS_SENDER_ID=""

# Storage (for later)
STORAGE_PROVIDER="local"
# ============================================
